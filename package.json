{
  "name": "level-up-api",
  "version": "1.0.0",
  "description": "LEVEL UP: personal growth app (web UI + REST API). One day at a time. One level at a time.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "web:install": "npm --prefix web install",
    "web:build": "npm --prefix web run build",
    "app": "npm run web:install && npm run web:build && tsx --env-file-if-exists=.env src/server.ts",
    "start:app": "tsx --env-file-if-exists=.env src/server.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
