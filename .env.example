# Server
PORT=4000
# Secret used to sign login tokens. REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string
# Where the SQLite file lives. Use :memory: for throwaway runs.
DATABASE_PATH=./data/levelup.db
# Comma-separated list of allowed web origins (CORS). Empty = allow all (dev only).
CORS_ORIGINS=http://localhost:5173

# Optional AI coaching. Leave empty and the API uses its built-in rule-based coach.
# The key stays on the server and is never sent to clients.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
